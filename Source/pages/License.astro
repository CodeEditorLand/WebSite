---
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.license.title", {
	defaultValue: "License | Code Editor Land",
});

const MetaDescription = T("meta.license.description", {
	defaultValue:
		"Code Editor Land is open source under the Creative Commons CC0 1.0 Universal license.",
});

// Full CC0 1.0 Universal text
