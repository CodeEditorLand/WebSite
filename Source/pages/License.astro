---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en">
	<Header client:load Mode="functional" />
	<div class="container mx-auto max-w-4xl px-4 py-16">
		<!-- Breadcrumbs -->
		<nav aria-label="Breadcrumb" class="LegalPrintHide mb-8">
			<ol
				class="flex flex-wrap items-center space-x-2 text-muted-foreground">
				<li>
					<a href="/" class="transition-colors hover:text-foreground"
						>Home</a
					>
				</li>
				<li class="mx-2">/</li>
				<li>
					<span class="font-medium text-foreground">License</span>
				</li>
			</ol>
		</nav>

		<!-- Page Header -->
		<header class="mb-12">
			<h1 class="text-2xl font-medium tracking-tight sm:text-3xl">
				License
			</h1>
			<p class="text-muted">
				Code Editor Land is open source software dedicated to the public
				domain.
			</p>
		</header>

		<!-- Content -->
		<article class="LegalCard prose prose-slate max-w-none">
			<section class="mb-10">
				<h2 class="mb-4 text-2xl font-medium">CC0 1.0 Universal</h2>
				<p class="mb-4">
					The Code Editor Land project, including all source code,
					documentation, and related materials, is dedicated to the
					public domain under the <a
						href="https://creativecommons.org/publicdomain/zero/1.0/"
						target="_blank"
						rel="noopener noreferrer"
						>Creative Commons CC0 1.0 Universal</a
					> license.
				</p>
				<div class="bg-mute mb-6 flat border border-[var(--Border)] p-6">
					<p class="mb-4 text-muted-foreground">
						<strong>What this means:</strong> You are free to use, modify,
						distribute, and use the code for any purpose, including commercial
						purposes, without attribution or restrictions. The authors
						have waived all copyright and related rights to the fullest
						extent permitted by law.
					</p>
					<p class="text-muted-foreground">
						This is not a "copyfree" license-it is a public domain
						dedication with a fallback license. See the full legal
						text below.
					</p>
				</div>
			</section>

			<section class="mb-10">
				<h2 class="mb-4 text-2xl font-medium">Full License Text</h2>
				<div
					class="bg-mute flex items-start gap-4 overflow-x-auto flat border border-[var(--Border)] p-6">
					<pre
						class="min-w-0 flex-1 whitespace-pre-wrap font-mono leading-relaxed text-foreground">{CC0LicenseText}</pre>
					<jelly-icon-button
						data-copy
						size="small"
						shape="square"
						label="Copy to clipboard"
						aria-label="Copy to clipboard"
						title="Copy to clipboard"
						style="--jelly-fill: var(--Mute); --jelly-label: var(--Foreground); --jelly-icon-button-radius: 0px; --jelly-ring: var(--Accent);"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							style="color: var(--jelly-label)"
							aria-hidden="true"
							><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path
								d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
							/></svg
						>
					</jelly-icon-button>
				</div>
			</section>

			<section class="mb-10">
				<h2 class="mb-4 text-2xl font-medium">Key Points</h2>
				<ul class="mb-4 list-disc space-y-2 pl-8">
					<li>
						<strong>No copyright restrictions:</strong> To the fullest
						extent permitted by law, the authors have waived all copyright
						and related rights.
					</li>
					<li>
						<strong>Free for all uses:</strong> Use, modify, distribute,
						and use commercially without permission or attribution.
					</li>
					<li>
						<strong>No warranty:</strong> The work is provided "as-is"
						without any warranties.
					</li>
					<li>
						<strong>Trademarks not included:</strong> The "Code Editor
						Land", "Land", and associated logos are trademarks and are
						not licensed under CC0.
					</li>
					<li>
						<strong>Third-party components:</strong> Some dependencies
						may be under different licenses. These are documented in the
						source repository.
					</li>
				</ul>
			</section>

			<section class="mb-10">
				<h2 class="mb-4 text-2xl font-medium">
					Third-Party Licenses
				</h2>
				<p class="mb-4">
					The Code Editor Land project incorporates numerous
					third-party open-source components. Each component retains
					its original license. The project as a whole is dedicated to
					the public domain, but individual components may be under:
				</p>
				<ul class="mb-4 list-disc space-y-2 pl-8">
					<li>MIT License</li>
					<li>Apache License 2.0</li>
					<li>BSD Licenses (2-clause, 3-clause)</li>
					<li>Other permissive open-source licenses</li>
				</ul>
				<p>
					For a complete list of dependencies and their licenses,
					please refer to the <code>Cargo.toml</code> file for Rust components
					and <code>package.json</code> for web components in the <a
						href="https://github.com/CodeEditorLand/Land"
						target="_blank"
						rel="noopener noreferrer">source repository</a
					>.
				</p>
				<p class="mt-4">
					<strong>Trademark Notices:</strong> VS Code is a trademark of
					Microsoft Corporation. Code Editor Land is not affiliated with
					or endorsed by Microsoft. Tauri is a trademark of the Tauri Programme
					within the Commons Conservancy. Effect-TS is MIT licensed.
				</p>
			</section>

			<section class="mb-10">
				<h2 class="mb-4 text-2xl font-medium">Why CC0?</h2>
				<p class="mb-4">
					We believe that foundational software tools should be freely
					available to everyone, without barriers or restrictions. By
					dedicating Code Editor Land to the public domain, we ensure
					that:
				</p>
				<ul class="mb-4 list-disc space-y-2 pl-8">
					<li>
						Developers, researchers, and companies can use the code
						without legal concerns
					</li>
					<li>
						Educational institutions can freely incorporate the code
						into curricula
					</li>
					<li>
						The community can fork, modify, and improve the project
						without permission
					</li>
					<li>
						The work remains free forever, regardless of future
						changes in ownership or project direction
					</li>
				</ul>
				<p>
					This dedication aligns with our mission to provide a
					high-quality, accessible code editor to developers
					worldwide.
				</p>
			</section>

			<section class="mb-10">
				<div class="mb-4 flex flex-wrap gap-x-6 gap-y-2">
					<a
						href="/Contact/Legal"
						class="StaccatoButton font-medium text-primary hover:underline"
						>Legal Enquiry form (LEGAL)<span class="InlineSeparator"
							>&#9993;</span
						></a
					>
					<a
						href="https://github.com/CodeEditorLand/Land"
						target="_blank"
						rel="noopener noreferrer"
						class="StaccatoButton font-medium text-primary hover:underline"
						>github.com/CodeEditorLand/Land<span
							class="InlineSeparator">→</span
						></a
					>
				</div>
				<h2 class="mb-4 text-2xl font-medium">Contact</h2>
				<p>
					If you have questions about the license, feel free to
					contact us.
				</p>
			</section>
		</article>

		<div class="LegalPrintHide mt-12 border-t pt-8">
			<a href="#top" class="StaccatoButton text-primary hover:underline"
				>Back to top<span class="InlineSeparator">↑</span></a
			>
		</div>
	</div>

	<!-- Schema.org Structured Data -->
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "WebPage",
			"name": "License",
			"description": "Code Editor Land License - CC0 1.0 Universal",
			"url": Astro.url.href,
			"license": "https://creativecommons.org/publicdomain/zero/1.0/",
			"datePublished": "2026-03-26T00:00:00Z",
			"dateModified": "2026-05-29T00:00:00Z",
			"author": [
				{
					"@type": "Person",
					"name": "Nikola R. Hristov",
					"url": "https://github.com/NikolaRHristov"
				},
				{
					"@type": "Organization",
					"name": "Code Editor Land",
					"url": Astro.site?.href ?? ""
				},
				{
					"@type": "Organization",
					"name": "PlayForm",
					"url": "https://PlayForm.Cloud"
				}
			],
			"publisher": {
				"@type": "Organization",
				"name": "Code Editor Land",
				"url": Astro.site?.href ?? "",
				"logo": {
					"@type": "ImageObject",
					"url": `${Astro.site?.href ?? ""}Favicon/favicon.svg`
				}
			},
			"inLanguage": "en",
			"isPartOf": {
				"@type": "WebSite",
				"name": "Code Editor Land",
				"url": Astro.site?.href ?? ""
			}
		}
	</script>
</Base>

<script>
	import { WireCopyButtons } from "../Function/Utility/CopyCommand";
	WireCopyButtons();
</script>
