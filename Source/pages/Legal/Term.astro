---
import { Header } from "../../Component/Layout/Header";
import Base from "../../Layout/Base.astro";
import { GetI18n } from "../../Library/I18n/Server";

const T = GetI18n();

const MetaTitle = T("meta.legal.terms.title", {
	defaultValue: "Terms of Service | Code Editor Land",
});

const MetaDescription = T("meta.legal.terms.description", {
	defaultValue:
		"Terms of Service for Code Editor Land - Governing your use of our open-source code editor and related services.",
});

const EffectiveDate = "March 26, 2026";
const LastUpdated = "May 29, 2026";
---

<Base
	Title={MetaTitle}
	Description={MetaDescription}
	Url={Astro.url.href}
	lang="en">
	<Header client:load />
	<div class="container mx-auto max-w-4xl px-4 py-16">
		<nav aria-label="Breadcrumb" class="LegalPrintHide mb-8">
			<ol
				class="flex flex-wrap items-center space-x-2 text-muted-foreground">
				<li>
					<a href="/" class="transition-colors hover:text-foreground"
						>Home</a
					>
				</li>
				<li class="mx-2">/</li>
				<li>
					<span class="font-medium text-foreground"
						>Terms of Service</span
					>
				</li>
			</ol>
		</nav>

		<header class="mb-12">
			<h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">
				Terms of Service
			</h1>
			<div class="space-y-1 text-muted-foreground">
				<p><strong>Effective Date:</strong> {EffectiveDate}</p>
				<p><strong>Last Updated:</strong> {LastUpdated}</p>
			</div>
		</header>

				<article class="LegalCard prose prose-slate max-w-none">
			<ul class="LegalPrintHide">
				<li>
					<a href="#terms-of-service">TERMS OF SERVICE</a>
					<ul>
						<li><a href="#introduction">Introduction</a></li>
						<li><a href="#communications">Communications</a></li>
						<li><a href="#purchases">Purchases</a></li>
						<li>
							<a href="#contests-sweepstakes-and-promotions"
								>Contests, Sweepstakes and Promotions</a
							>
						</li>
						<li><a href="#subscriptions">Subscriptions</a></li>
						<li><a href="#free-trial">Free Trial</a></li>
						<li><a href="#fee-changes">Fee Changes</a></li>
						<li><a href="#refunds">Refunds</a></li>
						<li><a href="#content">Content</a></li>
						<li><a href="#prohibited-uses">Prohibited Uses</a></li>
						<li>
							<a href="#no-use-by-minors">No Use by Minors</a>
						</li>
						<li><a href="#accounts">Accounts</a></li>
						<li>
							<a href="#intellectual-property"
								>Intellectual Property</a
							>
						</li>
						<li>
							<a href="#copyright-policy">Copyright Policy</a>
						</li>
						<li>
							<a
								href="#dmca-notice-and-procedure-for-copyright-infringement-claims"
								>DMCA Notice and Procedure for Copyright
								Infringement Claims</a
							>
						</li>
						<li>
							<a href="#error-reporting-and-feedback"
								>Error Reporting and Feedback</a
							>
						</li>
						<li>
							<a href="#links-to-other-web-sites"
								>Links To Other Web Sites</a
							>
						</li>
						<li>
							<a href="#disclaimer-of-warranty"
								>Disclaimer Of Warranty</a
							>
						</li>
						<li>
							<a href="#limitation-of-liability"
								>Limitation Of Liability</a
							>
						</li>
						<li><a href="#termination">Termination</a></li>
						<li><a href="#governing-law">Governing Law</a></li>
						<li>
							<a href="#changes-to-service">Changes To Service</a>
						</li>
						<li>
							<a href="#amendments-to-terms"
								>Amendments To Terms</a
							>
						</li>
						<li>
							<a href="#waiver-and-severability"
								>Waiver And Severability</a
