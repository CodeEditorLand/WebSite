---
import { DynamicReleaseManifest } from "../Component/Dynamic/DynamicReleaseManifest";
import { DynamicTransparency } from "../Component/Dynamic/DynamicTransparency";
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";

const T = GetI18n();

const TransparencyContent = {
	Title: T("download.transparency.title", {
		defaultValue: "Telemetry Is Compile-Gated in Land.",
	}),
	Subtitle: T("download.transparency.subtitle", {
		defaultValue:
			"Telemetry and tracing are behind named Rust feature gates in the native layer. Nothing is emitted by default. Each build profile explicitly lists which paths are compiled in.",
	}),
	Policy: [
		{
			Identifier: "no-telemetry-default",
			Title: "Compile-gated by default.",
			Description:
				"Telemetry and tracing code lives behind `cfg(feature)` gates. In a standard build those paths are not compiled in - no collection, no emission, no runtime cost.",
			Icon: "EyeOff",
			Status: "Disabled" as const,
			Detail: "Telemetry feature paths are excluded from the default build profile.",
		},
		{
			Identifier: "no-crash-reporter",
			Title: "No Microsoft endpoint dependency.",
			Description:
				"Land is built from a CC0 Code-OSS base with Microsoft service dependencies removed or replaced. The crash reporter, update service, and marketplace endpoints are all replaced with Land-owned wiring or left unconnected.",
			Icon: "Shield",
			Status: "Disabled" as const,
			Detail: "CC0-licensed Code-OSS base with Land-owned service wiring.",
		},
		{
			Identifier: "no-phone-home",
			Title: "Three separate systems, three separate controls.",
			Description:
				"Website analytics, account authentication, and editor telemetry are independent systems. Each is controlled by its own feature flag or environment configuration - none of the three implies the others are active.",
			Icon: "Lock",
			Status: "Disabled" as const,
		},
		{
			Identifier: "zero-cost-noop",
			Title: "Disabled feature paths stay out of the runtime.",
			Description:
				"Rust `cfg(feature)` gates eliminate disabled code paths at compile time, not just at runtime. A published build profile is a verifiable record of exactly which features were included.",
			Icon: "Zap",
			Status: "Active" as const,
			Detail: "Rust cfg(feature) gates eliminate dead code at compile time.",
		},
		{
			Identifier: "opt-in-otel",
			Title: "Need traces? Opt in. Your infrastructure only.",
			Description:
				"OpenTelemetry tracing is available in source and activates only when a deployment explicitly enables it with a named feature flag and a configured endpoint. Trace data goes to your infrastructure.",
			Icon: "Eye",
			Status: "Optional" as const,
			Detail: "cargo build --features Telemetry\nSub-features: MetricsCollection, DistributedTracing.",
		},
		{
			Identifier: "effect-ts-local",
			Title: "Extension host timing stays in the process.",
			Description:
				"Cocoon has internal timing and service diagnostics for extension-host work. Unless a transport is configured, that data is local process instrumentation rather than an external product-analytics claim.",
			Icon: "Layers",
			Status: "Active" as const,
			Detail: "Effect-TS TelemetryService with TelemetryMock layer for zero-overhead testing.",
		},
	],
	Variant: [
		{
			Identifier: "debug",
			Name: "debug",
			Tier: "Debug" as const,
			Workbench: "Browser",
			Feature: "Browser UI",
			Status: "Available" as const,
		},
		{
			Identifier: "debug-mountain",
			Name: "debug-mountain",
			Tier: "Debug" as const,
			Workbench: "Mountain",
			Feature: "Mountain UI",
			Status: "Recommended" as const,
		},
		{
			Identifier: "debug-electron",
			Name: "debug-electron",
			Tier: "Debug" as const,
			Workbench: "Electron",
			Feature: "Legacy Check",
			Status: "Legacy" as const,
		},
		{
			Identifier: "production",
			Name: "production",
			Tier: "Release" as const,
			Workbench: "Mountain",
			Feature: "Release Path",
			Status: "Recommended" as const,
		},
		{
			Identifier: "release",
			Name: "release",
			Tier: "Release" as const,
			Workbench: "Mountain",
			Feature: "Bundle Path",
			Status: "Available" as const,
		},
		{
			Identifier: "web-browser",
			Name: "web-browser",
			Tier: "Release" as const,
			Workbench: "Browser",
			Feature: "Web Path",
			Status: "Available" as const,
		},
		{
			Identifier: "bundler-preparation",
			Name: "bundler-preparation",
			Tier: "Build" as const,
			Workbench: "-",
			Feature: "-",
			Status: "Available" as const,
		},
		{
			Identifier: "swc-bundle",
			Name: "swc-bundle",
			Tier: "Build" as const,
			Workbench: "-",
			Feature: "-",
			Status: "Experimental" as const,
		},
		{
			Identifier: "oxc-bundle",
			Name: "oxc-bundle",
			Tier: "Build" as const,
			Workbench: "-",
			Feature: "-",
			Status: "Experimental" as const,
		},
	],
	Strategy: [
		{
			Identifier: "dev-hot-reload",
			Name: "Development",
			Description:
				"Change a file, see it instantly. Hot-reload in Tauri with the Sky dev server. No manual rebuilds needed.",
			Icon: "Zap",
			Command: "bash Maintain/Dev-Mountain.sh",
			Feature: [
				"Hot Reload",
				"Instant Preview",
				"Development Server",
				"No Bundling",
			],
		},
		{
			Identifier: "debug-build",
			Name: "Debug Build",
			Description:
				"Full debug symbols for stepping through code. Three profiles: Browser, Mountain, and Electron.",
			Icon: "Code",
			Command: "bash Maintain/Debug/Build.sh --profile debug-mountain",
			Feature: [
				"Debug Symbols",
				"3 Profiles",
				"Source Maps",
				"File Watch",
			],
		},
		{
			Identifier: "production-release",
			Name: "Release Build",
			Description:
				"Optimized release packaging path. Public signing and verification artifacts are still being prepared.",
			Icon: "Server",
			Command: "bash Maintain/Release/Build.sh --profile production",
			Feature: [
				"Optimized",
				"Signing Planned",
				"Clean Build",
				"Packaged",
			],
		},
		{
			Identifier: "web-only",
			Name: "Web Deployment",
			Description:
				"Run Land in the browser without installing anything. No native shell needed.",
			Icon: "Layers",
			Command: "bash Maintain/Release.sh --profile web-browser",
			Feature: [
				"No Install",
				"Browser Only",
				"Web Deploy",
				"OXC Bundled",
			],
		},
	],
	MatrixPermutation: 16,
	SourceURL: "https://github.com/CodeEditorLand/Land",
} as const;

// Release manifest content - field-record grammar
const ReleaseManifestContent = {
	Title: T("download.page.title", { defaultValue: "Release Manifest" }),
	Subtitle: T("download.page.subtitle", {
		defaultValue:
			"Source builds are active today. Public installers, signing, and verification artifacts are still being prepared.",
	}),
	ReleaseIndex: "RELEASE_01",
	Platforms: [
		{
			Name: "macOS",
			Channel: "PUBLIC",
			Arch: "AARCH64 / X86_64",
			Signing: "IN PREPARATION" as const,
			Size: "45.2 MB",
			Checksum: "Available with public release artifacts",
			Status: "active" as const,
			DownloadUrl: "https://github.com/CodeEditorLand/Land/releases",
			DownloadLabel: "VIEW SOURCE BUILDS",
		},
		{
			Name: "Windows",
			Channel: "PUBLIC",
			Arch: "X86_64",
			Signing: "IN PREPARATION" as const,
			Size: "-",
			Checksum: "-",
			Status: "preparing" as const,
		},
		{
			Name: "Linux",
			Channel: "PUBLIC",
			Arch: "X86_64",
			Signing: "IN PREPARATION" as const,
			Size: "-",
			Checksum: "-",
			Status: "preparing" as const,
		},
	],
};

const MetaTitle = T("meta.downloads.title", {
	defaultValue:
		"Download Code Editor Land | Source Builds and Public Release Prep",
});
const MetaDescription = T("meta.downloads.description", {
	defaultValue:
		"Code Editor Land source builds target macOS, Windows, and Linux. Public installers, signing, and verification artifacts are still being prepared.",
});
---

<Base Title={MetaTitle} Description={MetaDescription}>
	<Header client:load />
	<div
		class="container mx-auto flex flex-wrap items-center justify-center gap-3 px-4 pt-6 text-foreground"
	>
		<img
			alt="Land"
			src="/Asset/Dark/Logo/Glyph/Land.svg"
			width="24"
			height="24"
		/>
		<jelly-badge
			variant="mint"
			shape="square"
			style={`--jelly-fill:var(--SpinegRPCMute);--jelly-label:var(--SpinegRPCFore);--jelly-badge-radius:0;--jelly-badge-font-size:11px`}
		>
			Telemetry Feature Gated&#x2001;<span
				class="flat h-1.5 w-1.5"
				style="background-color:var(--SpinegRPC)"
				aria-hidden="true"></span>
		</jelly-badge>
		<jelly-badge
			variant="mint"
			shape="square"
			style={`--jelly-fill:var(--SpinegRPCMute);--jelly-label:var(--SpinegRPCFore);--jelly-badge-radius:0;--jelly-badge-font-size:11px`}
		>
			CC0 Licensed
		</jelly-badge>
		<jelly-badge
			variant="platinum"
			shape="square"
			style={`--jelly-fill:var(--Mute);--jelly-label:var(--MuteForeground);--jelly-badge-radius:0;--jelly-badge-font-size:11px`}
		>
			Signing Planned
		</jelly-badge>
		<jelly-badge
			variant="azure"
			shape="square"
			style={`--jelly-fill:var(--SpineIPCMute);--jelly-label:var(--SpineIPCFore);--jelly-badge-radius:0;--jelly-badge-font-size:11px`}
		>
			Native Rust&#x2001;<img
				src="/Dark/Image/Rust.svg"
				alt=""
				width="14"
				height="14"
				class="opacity-70"
				aria-hidden="true"
			/>
		</jelly-badge>
		<jelly-badge
			variant="amber"
			shape="square"
			style={`--jelly-fill:var(--ExtensionTauriMute);--jelly-label:var(--ExtensionTauriFore);--jelly-badge-radius:0;--jelly-badge-font-size:11px`}
		>
			Tauri&#x2001;<img
				src="/Dark/Image/Tauri.svg"
				alt=""
				width="14"
				height="14"
				class="opacity-70"
				aria-hidden="true"
			/>
		</jelly-badge>
		<jelly-badge
			variant="platinum"
			shape="square"
			style={`--jelly-fill:var(--ExtensionEffectTypeScriptMute);--jelly-label:var(--ExtensionEffectTypeScriptFore);--jelly-badge-radius:0;--jelly-badge-font-size:11px`}
		>
			Effect-TS&#x2001;<img
				src="/Dark/Image/EffectTS.svg"
				alt=""
				width="14"
				height="14"
				class="opacity-70"
				aria-hidden="true"
			/>
		</jelly-badge>
		<jelly-badge
			variant="platinum"
			shape="square"
			style={`--jelly-fill:var(--Mute);--jelly-label:var(--MuteForeground);--jelly-badge-radius:0;--jelly-badge-font-size:11px`}
		>
			macOS + Windows + Linux Targets
		</jelly-badge>
		<jelly-badge
			variant="platinum"
			shape="square"
			style={`--jelly-fill:var(--Mute);--jelly-label:var(--MuteForeground);--jelly-badge-radius:0;--jelly-badge-font-size:11px`}
		>
			Unmodified Extensions
		</jelly-badge>
	</div>
	<DynamicReleaseManifest Content={ReleaseManifestContent} client:load />
	<DynamicTransparency Content={TransparencyContent} client:load />
</Base>
