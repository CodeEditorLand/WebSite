---
import { Header } from "../Component/Layout/Header";
import Base from "../Layout/Base.astro";
import { GetI18n } from "../Library/I18n/Server";
import { FieldRecordDataCard } from "../Component/Brand/FieldRecordDataCard";
import { FieldRecordIndex } from "../Component/Brand/FieldRecordIndex";
import { FieldRecordStatus } from "../Component/Brand/FieldRecordStatus";
import { FieldRecordAction } from "../Component/Brand/FieldRecordAction";
import { FieldRecordEvidence } from "../Component/Brand/FieldRecordEvidence";

const T = GetI18n();

const MetaTitle = T("common.error.404", {
	defaultValue: "404 - Page Not Found",
});
const MetaDescription = T("common.error.pageNotFound", {
	defaultValue:
		"The page you're looking for doesn't exist or has been moved.",
});

const RequestedPath = Astro.url.pathname;
---

<Base Title={MetaTitle} Description={MetaDescription} noIndex={true}>
	<Header client:load />
	<section
		id="NotFoundContent"
		class="flex min-h-[80dvh] w-full flex-col items-center justify-center py-20"
		aria-label="Page not found"
	>
		<div class="container mx-auto px-4">
			<div class="mx-auto max-w-3xl">
				<div class="flex flex-col md:flex-row">
					<div class="min-w-0 flex-1">
						<FieldRecordDataCard className="h-full">
							<div class="flex h-full flex-col gap-4">
								<FieldRecordIndex
									index="ROUTE_404"
									client:load
								/>

								<p
									class="text-field-xl font-mono font-normal leading-[0.95] tracking-[-0.02em] text-card-foreground"
								>
									〈NOT FOUND〉
								</p>

								<p
									class="text-field-s font-mono font-normal leading-[1.1] text-card-foreground opacity-70"
								>
									/TRACE: {RequestedPath}
								</p>

								<div class="mt-6">
									<FieldRecordStatus
										status="interrupted"
										tone="quiet"
										client:load
									/>
								</div>

								<div class="mt-2">
									<p
										class="text-field-s font-mono uppercase tracking-wider text-card-foreground opacity-60"
									>
										SIGNAL: ABSENT{"\u2001"}ROUTE: UNRESOLVED
									</p>
								</div>

								<div class="my-12 flex-1" aria-hidden="true">
								</div>

								<div>
									<p
										class="text-field-l font-mono font-normal leading-[1.08] text-card-foreground"
									>
										LAND:
									</p>
									<p
										class="text-field-s mt-3 font-mono font-normal leading-[1.1] text-card-foreground opacity-70"
									>
										↳RETURN TO INDEX
									</p>
								</div>

								<div class="mt-10">
									<FieldRecordAction
										label="BACK TO LAND"
										href="/"
										variant="button"
										client:load
									/>
								</div>
							</div>
						</FieldRecordDataCard>
					</div>

					<div
						class="hidden w-px md:block"
						style="background-color: var(--Background)"
						aria-hidden="true"
					>
					</div>

					<div class="min-w-0 flex-1">
						<FieldRecordEvidence
							src="/Evidence/Land/NightGlass-01.png"
							alt="Rain-speckled glass reflecting a green light at night"
							position="center"
							className="h-full min-h-[40dvh] w-full"
							client:load
						/>
					</div>
				</div>
			</div>
		</div>
	</section>
</Base>
